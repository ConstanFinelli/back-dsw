# ============================================
# TIMEZONE
# ============================================
TZ=America/Argentina/Buenos_Aires

# ============================================
# BASE DE DATOS
# ============================================
# Elegí UNO de los dos presets y descomentá las 2 líneas.

# --- PRESET A: Postgres local (Docker Compose) ---
DB_CLIENT_URL=postgresql://dsw-user-back:backdsw-backend@localhost:5432/backdsw
DB_SSL=false

# --- PRESET B: Neon (Postgres serverless) ---
# DB_CLIENT_URL=postgresql://neon_user_abc123:npass_XyZ789@ep-cool-abc12345.us-east-2.aws.neon.tech/backdsw?sslmode=require
# DB_SSL=true

# ============================================
# JWT
# ============================================
JWT_SECRET=super-secret-jwt-key-cambiar-en-produccion-123456789

# ============================================
# CLOUDINARY
# ============================================
CLOUDINARY_CLOUD_NAME=demo-canchas
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdef1234567890abcdef1234567890

# ============================================
# SMTP
# ============================================
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=mailtrap_user_demo
SMTP_PASS=mailtrap_pass_demo
MAIL_FROM=no-reply@example.com

# ============================================
# DEBUG
# ============================================
DB_DEBUG=false
