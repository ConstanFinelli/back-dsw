{
  "name": "backend",
  "version": "1.0.0",
  "description": "Repositorio donde se encuentra todo el contenido de back-end del TP para desarrollo de software",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "start": "node ./dist/app.js",
    "dev": "tsc-watch --noClear -p ./tsconfig.json --onSuccess \"node ./dist/app.js\"",
    "migration:create": "mikro-orm-esm migration:create",
    "migration:up": "mikro-orm-esm migration:up",
    "migration:down": "mikro-orm-esm migration:down",
    "migration:list": "mikro-orm-esm migration:list",
    "migration:pending": "mikro-orm-esm migration:pending"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConstanFinelli/back-dsw.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ConstanFinelli/back-dsw/issues"
  },
  "homepage": "https://github.com/ConstanFinelli/back-dsw#readme",
  "dependencies": {
    "@mikro-orm/core": "^6.6.17",
    "@mikro-orm/migrations": "^6.6.17",
    "@mikro-orm/postgresql": "^6.6.17",
    "@types/multer": "^2.0.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "googleapis": "^161.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.14",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.6.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.1.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-watch": "^6.0.4",
    "typescript": "^5.8.3"
  }
}
